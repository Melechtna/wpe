{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallPaper Engine Next",
  "version": "0.1.0",
  "identifier": "com.wpe-next.app",
  "build": {
    "frontendDist": "src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WallPaper Engine Next",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
